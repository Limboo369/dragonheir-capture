# Copy this file to .env (same folder as the program) and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model reads the screenshots.
#   claude-haiku-5-5  cheap (default)      ~ $0.001 per screen
#   claude-opus-5-5   most accurate        ~ $0.03 per screen
MODEL=claude-haiku-5-5
EFFORT=medium

# Quick look at a small image first; only screens with account data get a full read.
PRECHECK=true
PRECHECK_MODEL=claude-haiku-5-5

# AUTO=true reads new screens every INTERVAL_SECONDS. The hotkey reads the current screen now.
AUTO=true
HOTKEY=F8

# "api" = read screens with Claude. "collect" = only save unique screens as JPEG, no cost.
MODE=api

INTERVAL_SECONDS=5
MAX_CALLS_PER_HOUR=120
DAILY_BUDGET_USD=1.00

# false = delete each screenshot as soon as Claude has read it (only text is kept).
KEEP_IMAGES=false
JPEG_QUALITY=80
MAX_IMAGE_EDGE=1568
